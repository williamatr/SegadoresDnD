{
  "name": "segadores-dnd-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo para SegadoresDnD - Wiki de campaña y gestor interactivo de personajes",
  "scripts": {
    "submodule:sync": "node scripts/sync-wiki.mjs",
    "sync:push": "node scripts/sync-characters-push.mjs",
    "sync:demo": "node scripts/sync-demo-characters.mjs",
    "sync:pull": "node scripts/sync-characters-pull.mjs",
    "pre-commit": "node scripts/verify-secrets.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "predev": "pnpm submodule:sync",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@11.28.5"
}
