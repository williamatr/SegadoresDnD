# ==============================================================================
# Variables de Entorno - SegadoresDnD
# ==============================================================================
# Copia este archivo como .env.local para desarrollo local:
#   cp .env.example apps/segadores-web/.env.local
# Y agrégalas en el panel de configuración de Vercel en producción.
# ==============================================================================

# Supabase (Base de Datos & Autenticación)
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<tu-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<tu-service-role-key>

# Control de Acceso (Lista blanca separada por comas)
ALLOWED_EMAILS=dm@ejemplo.com,jugador1@ejemplo.com,jugador2@ejemplo.com

# URL del Sitio Web (En producción: tu dominio de Namecheap / Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ruta local a la Bóveda de Obsidian (Solo para desarrollo local, ignorado en Git)
# En producción (Vercel) la app leerá directamente desde content/wiki/ (Git Submodule)
OBSIDIAN_VAULT_PATH=/ruta/a/tu/boveda/obsidian

